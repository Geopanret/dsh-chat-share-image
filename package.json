{
  "name": "dsh-chat-share-image",
  "version": "0.2.0",
  "description": "Copy one finished assistant reply as a long PNG screenshot — tables re-laid out, referenced images full-size, overlong replies split into readable parts.",
  "type": "module",
  "license": "MIT",
  "author": "Geopanret",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "long-image",
    "clipboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geopanret/dsh-chat-share-image.git"
  },
  "homepage": "https://github.com/Geopanret/dsh-chat-share-image#readme",
  "bugs": {
    "url": "https://github.com/Geopanret/dsh-chat-share-image/issues"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
